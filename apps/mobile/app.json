{
  "expo": {
    "name": "MYRYRA",
    "slug": "myryra",
    "scheme": "myryra",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.myryra.app",
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Permita que a MYKA use o microfone para gravar suas mensagens de voz.",
          "recordAudioAndroid": true
        }
      ]
    ]
  }
}
